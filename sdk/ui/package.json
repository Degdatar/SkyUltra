{
  "name": "@skyultra/ui",
  "version": "0.1.0",
  "description": "Reusable themed React components for SkyUltra web mods.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./widgets": {
      "types": "./dist/widgets.d.ts",
      "import": "./dist/widgets.js"
    },
    "./interaction": {
      "types": "./dist/interaction.d.ts",
      "import": "./dist/interaction.js"
    },
    "./styles.css": "./dist/styles.css",
    "./field/*": {
      "types": "./dist/field/*.d.ts",
      "import": "./dist/field/*.js"
    },
    "./menu": {
      "types": "./dist/menu.d.ts",
      "import": "./dist/menu.js"
    },
    "./game": {
      "types": "./dist/game.d.ts",
      "import": "./dist/game.js"
    },
    "./chrome": {
      "types": "./dist/chrome.d.ts",
      "import": "./dist/chrome.js"
    },
    "./menu.css": "./dist/menu.css",
    "./hud.css": "./dist/hud.css",
    "./chrome.css": "./dist/chrome.css",
    "./gameplay": {
      "types": "./dist/gameplay.d.ts",
      "import": "./dist/gameplay.js"
    },
    "./controls": {
      "types": "./dist/controls.d.ts",
      "import": "./dist/controls.js"
    },
    "./controls.css": "./dist/controls.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=18.3.0 <20.0.0",
    "react-dom": ">=18.3.0 <20.0.0"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "motion": "^14.9.0",
    "tailwind-merge": "^2.6.1",
    "@skyultra/sdk": "file:../typescript"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build:types": "tsc --project tsconfig.json",
    "build:css": "tailwindcss --config tailwind.config.cjs --input src/styles.css --output dist/styles.css --minify",
    "build": "npm run build:types && npm run build:css && node tools/copy-styles.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
